{
  "name": "livelocale",
  "version": "0.12.0",
  "description": "Click any text in your running React app to edit its translation. Edits stay as JSON in git, or arrive as a pull request from a deployed preview. Local-first, zero-dependency.",
  "license": "MIT",
  "author": "Araby99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Araby99/livelocale.git"
  },
  "bugs": {
    "url": "https://github.com/Araby99/livelocale/issues"
  },
  "homepage": "https://github.com/Araby99/livelocale#readme",
  "keywords": [
    "nextjs",
    "react",
    "i18n",
    "internationalization",
    "translation",
    "studio",
    "visual-editor",
    "localization",
    "in-context-editing",
    "zero-dependency",
    "vite",
    "i18next",
    "next-intl",
    "rtl",
    "git"
  ],
  "type": "module",
  "bin": {
    "livelocale": "dist/codemod/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run studio:build",
    "studio:dev": "vite src/studio --config src/studio/vite.config.ts",
    "studio:build": "vite build src/studio --config src/studio/vite.config.ts",
    "test": "vitest run",
    "test:package": "vitest run --exclude \"tests/unit/{site,brand}/**\"",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/check-invisible-chars.mjs && eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"site/src/**/*.{ts,tsx}\" \"site/scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"site/src/**/*.{ts,tsx}\" \"site/scripts/**/*.mjs\" \"README.md\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"site/src/**/*.{ts,tsx}\" \"site/scripts/**/*.mjs\" \"README.md\"",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "husky",
    "brand:build": "npm run brand --prefix site",
    "site:build": "npm run build --prefix site",
    "site:typecheck": "npm run build && node site/scripts/hardcoded-report.mjs && tsc -p site/tsconfig.json --noEmit",
    "test:site": "playwright test --config playwright.site.config.ts"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": ">=5.0.0",
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.31.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.10.2",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "fake-indexeddb": "^6.2.7",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.2",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vitest": "^1.6.0"
  }
}
