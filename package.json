{
  "name": "next-i18n-lens",
  "version": "0.1.8",
  "description": "A local-first, zero-dependency visual translation studio for Next.js (App Router) and React.",
  "license": "MIT",
  "author": "Araby99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Araby99/next-i18n-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Araby99/next-i18n-lens/issues"
  },
  "homepage": "https://github.com/Araby99/next-i18n-lens#readme",
  "keywords": [
    "nextjs",
    "react",
    "i18n",
    "internationalization",
    "translation",
    "studio",
    "visual-editor",
    "localization",
    "in-context-editing",
    "zero-dependency"
  ],
  "type": "module",
  "bin": {
    "next-i18n-lens": "dist/codemod/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run studio:build",
    "studio:dev": "vite src/studio --config src/studio/vite.config.ts",
    "studio:build": "vite build src/studio --config src/studio/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"README.md\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"README.md\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.6.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.5",
    "postcss": "^8.4.38",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.14",
    "vitest": "^5.0.3"
  }
}
