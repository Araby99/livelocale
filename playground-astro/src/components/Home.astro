---
import Layout from '../layouts/Layout.astro';
import { translationsFor, type Locale } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = translationsFor(locale);
---

<Layout locale={locale} page="">
  <h1>{t.home.title}</h1>
  <p id="intro">{t.home.intro}</p>
  <p id="cta">{t.home.cta}</p>
</Layout>
