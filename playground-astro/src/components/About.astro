---
import Layout from '../layouts/Layout.astro';
import { translationsFor, type Locale } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = translationsFor(locale);
---

<Layout locale={locale} page="about">
  <h1>{t.about.title}</h1>
  <p>{t.about.body}</p>
</Layout>
